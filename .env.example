# Copy to .env and change the values. .env is in .gitignore and never committed.

# PostgreSQL
DB_NAME=travel_planner
DB_USER=travel
DB_PASSWORD=change-me
# Host port for the containerised PostgreSQL. 5432 is taken by a native PostgreSQL service on the dev machine.
DB_PORT=5433

# API
APP_PORT=4567
DB_POOL=20
LOG_LEVEL=info

# Lab 4: replication role (created by db/replication/* init scripts from these variables)
REPL_USER=replicator
REPL_PASSWORD=change-me-too
REPLICA_PORT=55432
REPLICA2_PORT=55433

# Lab 4: synchronous standbys for the primary ("" = asynchronous replication)
SYNC_STANDBYS=ANY 1 (replica_1, replica_2)

# Lab 4: PgCat admin console password
PGCAT_ADMIN_PASSWORD=change-me
